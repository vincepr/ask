# Host port that maps to the container's internal port 3000.
ASK_SERVER_EXPOSE_PORT=13000

# Directory for SQLite DB and AI-generated knowledge markdown files.
ASK_DATA_DIR=.data

# Directory for resource files (code repos, configs, etc.) to index and search.
# Defaults to the current working directory.
ASK_SERVER_RESOURCE_DIR=.

# Embedding provider: tei (local TEI) or openai (external API).
ASK_SERVER_EMBEDDING_MODE=tei

# Base URL for the embedding provider.
# TEI mode (default): http://localhost:18080 maps to the TEI container port 80.
# OpenAI mode: e.g. https://api.openai.com/v1
ASK_SERVER_EMBEDDING_BASE_URL=http://localhost:18080

# OpenAI-compatible mode example (uncomment and fill in):
# ASK_SERVER_EMBEDDING_MODE=openai
# ASK_SERVER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ASK_SERVER_EMBEDDING_AUTH_TOKEN=sk-...
