ASK_SERVER_EXPOSE_PORT=13000
ASK_SERVER_BIND_PORT=3000
ASK_DATA_DIR=.data

# Embedding mode: tei or openai
ASK_SERVER_EMBEDDING_MODE=tei

# TEI mode default
ASK_SERVER_EMBEDDING_BASE_URL=http://tei:80

# OpenAI-compatible mode example
# ASK_SERVER_EMBEDDING_MODE=openai
# ASK_SERVER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ASK_SERVER_EMBEDDING_AUTH_TOKEN=replace-me
