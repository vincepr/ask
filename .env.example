# Host port mapping to container port 3000.
ASK_SERVER_EXPOSE_PORT=13000

# Directory for SQLite DB and AI knowledge files.
ASK_DATA_DIR=.data

# Directory for resource files to index (code, configs, etc.).
ASK_SERVER_RESOURCE_DIR=.

# Embedding provider: tei or openai.
ASK_SERVER_EMBEDDING_MODE=tei

# Embedding provider base URL for local TEI runs.
ASK_SERVER_EMBEDDING_BASE_URL=http://localhost:18080

# Exact embedding model string sent in the request body.
ASK_SERVER_EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX

# Qwen3-Embedding-0.6B-ONNX outputs 1024-dimensional vectors.
ASK_SERVER_EMBEDDING_DIMENSIONS=1024

# Maximum number of embedding inputs
ASK_SERVER_EMBEDDING_MAX_BATCH_SIZE=8

# --- OpenAI-compatible mode example (uncomment) ---
# ASK_SERVER_EMBEDDING_MODE=openai
# ASK_SERVER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# ASK_SERVER_EMBEDDING_MODEL=text-embedding-3-small
# ASK_SERVER_EMBEDDING_AUTH_TOKEN=sk-...
